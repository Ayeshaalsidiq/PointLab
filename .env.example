# PointLab Frontend Environment Variables
# Copy to .env and adjust values before deploy
# NOTE: .env is gitignored — never commit real secrets!

# Frontend API base URL (H-2 requirement)
# Set to the URL where the backend/PointLab API is served
# Example: https://panel.kroombox.com (for same-origin deployment)
# Example: https://pointlab-api.yourdomain.com (for cross-origin deployment)
VITE_API_BASE_URL=https://panel.kroombox.com

# RAG / AI Chatbot (optional)
VITE_RAG_API_URL=/api-rag/query
VITE_RAG_API_KEY=your_rag_api_key_here
VITE_RAG_KB_ID=kb_chat

# Gemini AI (optional, for chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Kroombox (backend MySQL)
DB_HOST=panel.kroombox.com
DB_PORT=3310
DB_USER=sql_ngolab
DB_PASSWORD=your_db_password_here
DB_NAME=ngola_geasture_adm

# JWT Secret (backend — use strong random string)
JWT_SECRET=your_strong_random_jwt_secret_here
